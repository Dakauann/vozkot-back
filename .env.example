APP_ENV=development
APP_NAME=Vozkot API
PORT=8080
CORS_ALLOW_ORIGIN=http://localhost:3000
READ_TIMEOUT=10s
WRITE_TIMEOUT=20s
IDLE_TIMEOUT=60s
JWT_SECRET=change-this-development-secret-before-production
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
COOKIE_DOMAIN=
COOKIE_SECURE=false
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=vozkot
DB_SSLMODE=disable
# Pool sizing (docs/SCALE.md): cover QUEUE_WORKERS x RABBITMQ_PREFETCH in-flight
# jobs plus the HTTP requests you expect at once, and stay below PostgreSQL's
# max_connections (200 in docker-compose) summed over every process.
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=30m
DB_CONN_MAX_IDLE_TIME=5m

# Baseline accounts created by `go run ./cmd/seed`
SEED_ADMIN_NAME=Administrador
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-this-admin-password
SEED_USER_NAME=Usuario Padrao
SEED_USER_EMAIL=user@example.com
SEED_USER_PASSWORD=change-this-user-password

# Media storage. Leave the Cloudflare values empty for local development and the
# API stores uploads under MEDIA_LOCAL_DIR, serving them from /media.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_KEY_ID=
CLOUDFLARE_R2_SECRET_KEY=
CLOUDFLARE_R2_BUCKET_NAME=
CLOUDFLARE_R2_ENDPOINT=
# Namespaces every object this app writes, so one bucket can serve more than
# one product safely. Empty writes to the bucket root.
CLOUDFLARE_R2_KEY_PREFIX=vozkot
MEDIA_LOCAL_DIR=storage/media
MEDIA_PUBLIC_BASE_URL=http://localhost:8080/media

# Purchases: Mercado Pago, using the same variable names as Vozko's backend.
# Leave the token empty and the box office runs without checkout (503 on it).
# The webhook secret is REQUIRED whenever the token is set: the endpoint fails
# closed rather than trusting unsigned notifications.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_NOTIFICATION_URL=
MERCADOPAGO_SIGNATURE_TOLERANCE=0
# Development only: address every sandbox charge to a Mercado Pago test user.
MERCADOPAGO_SANDBOX_PAYER_EMAIL=
# How long a reservation survives unpaid. 30m matches Mercado Pago's minimum
# PIX expiry so the charge and the hold lapse together.
CHECKOUT_HOLD_TTL=30m
CHECKOUT_RATE_LIMIT=30
CHECKOUT_RATE_WINDOW=1m
# Hard per-API-replica checkout bulkhead. Overflow receives 503 + Retry-After
# instead of queuing unbounded goroutines on the database pool.
CHECKOUT_MAX_IN_FLIGHT=20

# Job transport (RabbitMQ) and read cache / rate limiter (Redis). Both are
# optional: without them jobs are dispatched by the database poller and reads
# go straight to PostgreSQL.
RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5674/
# Prefetch is the per-worker concurrency on the broker path: that many jobs run
# at once. In-flight jobs = QUEUE_WORKERS x RABBITMQ_PREFETCH (broker) or
# QUEUE_WORKERS x QUEUE_BATCH_SIZE (poller); size DB_MAX_OPEN_CONNS for them.
RABBITMQ_PREFETCH=16
# Use quorum on a 3-node production cluster. Changing an existing classic queue
# requires a new queue name/migration; this switch is for fresh topology.
RABBITMQ_QUEUE_TYPE=classic
REDIS_URL=redis://127.0.0.1:6381/0
REDIS_KEY_PREFIX=vozkot
QUEUE_WORKERS=2
QUEUE_BATCH_SIZE=10
QUEUE_POLL_INTERVAL=1s
QUEUE_SWEEP_INTERVAL=1m
# One attempt's deadline. A job in flight when a deploy starts runs to its end;
# this is what bounds "its end".
QUEUE_JOB_TIMEOUT=2m
# Recovery jobs admitted by one payment sweep. Provider concurrency remains
# bounded by QUEUE_WORKERS x RABBITMQ_PREFETCH.
QUEUE_RECONCILE_BATCH_SIZE=1000
# Completed delivery records are operational data; orders and dead jobs remain.
QUEUE_COMPLETED_RETENTION=168h
QUEUE_CLEANUP_BATCH_SIZE=10000
